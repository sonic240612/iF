{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iF Character Card",
  "type": "object",
  "required": ["id", "name", "system_prompt", "first_message", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^char_[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 40},
    "system_prompt": {"type": "string", "minLength": 10},
    "first_message": {"type": "string", "minLength": 1},
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "greeting_mood": {"type": "string", "enum": ["cold", "warm", "playful", "neutral"]},
    "genre": {"type": "string"},
    "emoji": {"type": "string"},
    "gradient": {"type": "string"},
    "intro": {"type": "string", "maxLength": 2000},
    "worldview": {"type": "string", "maxLength": 2000},
    "example_dialogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["user", "character"],
        "properties": {
          "user": {"type": "string"},
          "character": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
